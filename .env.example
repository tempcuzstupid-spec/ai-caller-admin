# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # Postgres connection string (postgresql://user:pass@host:port/db)
                          # For Neon: postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Frontend (exposed to browser via Vite) ─────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID
VITE_FAST_API_URL=        # FastAPI AI Caller backend URL (e.g. https://ai-caller-api-82u7.onrender.com)

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Default Tenant (seeded on first boot) ──────────────────────
DEFAULT_TENANT_NAME=Premium Meridian
DEFAULT_TENANT_SLUG=premium-meridian
DEFAULT_TENANT_BRAND_NAME=Premium Meridian
DEFAULT_TENANT_BRAND_DOMAIN=premiummeridian.org
DEFAULT_TENANT_BRAND_PHONE=+13868438160
DEFAULT_TENANT_BRAND_EMAIL=management@premiummeridian.org
DEFAULT_TENANT_BRAND_LEGAL_NAME=Premium Meridian LLC
DEFAULT_TENANT_COMPLIANCE_TIER=hipaa
